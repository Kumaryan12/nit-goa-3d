# Public Firebase web configuration. Only VITE_* variables enter the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Server-only: NEVER add VITE_ to these names.
FIREBASE_PROJECT_ID=
# Use your host's secret manager for a dedicated runtime service account JSON.
# On Google Cloud, use its attached service identity instead (leave this empty).
FIREBASE_SERVICE_ACCOUNT=
# Alternative for local development: a private service account JSON file path.
GOOGLE_APPLICATION_CREDENTIALS=
# 32 random bytes, base64 encoded, for encrypted moderator TOTP and signed tickets.
MODERATOR_SECRET_KEY=
# Alternative: private file containing the same base64 key.
MODERATOR_SECRET_KEY_FILE=
# Exact public HTTPS origin; defaults to RENDER_EXTERNAL_URL on Render.
SITE_URL=
HOST=0.0.0.0
# Empty allows verified Google accounts. Restrict with exact comma-separated domains.
CAMPUS_EMAIL_DOMAINS=

VITE_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
# Omit these to use the same-origin live server.
VITE_FOOTBALL_URL=
VITE_OAT_URL=
# Public WebRTC ICE config. Use short-lived TURN credentials for production.
VITE_OAT_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
