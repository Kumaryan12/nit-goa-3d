  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node --experimental-strip-types scripts/build-social-seats.mjs && node scripts/compress-assets.mjs",
    "typecheck": "tsc -b",
